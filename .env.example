# Medición (src/lib/analytics.ts). Copia este archivo como .env.local o ponlas en Vercel → Settings → Environment Variables.
# Vacías = no se carga ningún script de terceros; los eventos igual quedan en window.dataLayer.
# Antes de activar el píxel de Meta, avisar del uso de cookies (Ley 29733 de protección de datos personales).

# ID de medición de Google Analytics 4 (Admin → Flujos de datos), formato G-XXXXXXXXXX
VITE_GA4_ID=

# ID del píxel de Meta (Administrador de eventos), solo números
VITE_META_PIXEL_ID=
